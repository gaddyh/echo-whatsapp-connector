# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
WORKER_ID=local-1
MAX_SESSIONS=20
SESSION_START_STAGGER_MS=5000
RECONNECT_BASE_DELAY_MS=2000
RECONNECT_MAX_DELAY_MS=60000
CLAIM_RENEW_TIMEOUT_MS=5000
RECOVERY_BACKOFF_INITIAL_MS=1000
RECOVERY_BACKOFF_MAX_MS=30000

# Shared PostgreSQL database used by Echo Guard and this connector.
# The connector owns only the whatsapp_connector schema/tables.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/echo
DATABASE_SSL=false
DB_POOL_MAX=10

# 32 random bytes encoded as base64. Used to encrypt Baileys credentials and Signal keys
# before storing them in PostgreSQL.
# Generate: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Internal HTTP API auth. Echo Guard sends: Authorization: Bearer <token>
INTERNAL_API_TOKEN=change-me

# WhatsApp/Baileys
# Leave empty to use fetchLatestWaWebVersion(). Set only during incidents / controlled rollout.
WA_WEB_VERSION_OVERRIDE=
# Example: 2.3000.1043857760

# Fixed browser identity for every connection (legacy/rollback mode).
# Leave empty (default): each connection gets a realistic browser fingerprint,
# chosen once at pairing and persisted in connections.settings. The linked
# device then shows as e.g. "Chrome on Windows" instead of the fixed name.
BAILEYS_BROWSER_NAME=

# Media handling: connector can emit metadata only by default.
# Set true only if Guard needs media bytes immediately.
DOWNLOAD_MEDIA=false
MAX_MEDIA_BYTES=10485760

# Event delivery
# db = write normalized events to whatsapp_connector.event_inbox (recommended with shared DB)
# http = POST normalized events to EVENT_WEBHOOK_URL
EVENT_SINK=db
EVENT_WEBHOOK_URL=
EVENT_WEBHOOK_TOKEN=

# Ops log monitor: hourly LLM digest of log-derived counters (LOG_MONITOR_ENABLED).
# Uses the same OpenAI account/model as echo-v2; the digest is logged and
# optionally POSTed to OPS_ALERT_ENDPOINT (echo-v2 ops-alert bridge).
LOG_MONITOR_ENABLED=false
LOG_MONITOR_DIGEST_MS=3600000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPS_ALERT_ENDPOINT=
OPS_ALERT_TOKEN=
