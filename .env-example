# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
WORKER_ID=local-1
MAX_SESSIONS=20
SESSION_START_STAGGER_MS=5000
RECONNECT_BASE_DELAY_MS=2000
RECONNECT_MAX_DELAY_MS=60000

# Shared PostgreSQL database used by Echo Guard and this connector.
# The connector owns only the whatsapp_connector schema/tables.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/echo
DATABASE_SSL=false
DB_POOL_MAX=10

# 32 random bytes encoded as base64. Used to encrypt Baileys credentials and Signal keys
# before storing them in PostgreSQL.
# Generate: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Internal HTTP API auth. Echo Guard sends: Authorization: Bearer <token>
INTERNAL_API_TOKEN=change-me

# WhatsApp/Baileys
# Leave empty to use fetchLatestWaWebVersion(). Set only during incidents / controlled rollout.
WA_WEB_VERSION_OVERRIDE=
# Example: 2.3000.1043857760

# Optional metadata used when presenting the linked device in WhatsApp.
BAILEYS_BROWSER_NAME=Echo Guard
BAILEYS_BROWSER_PLATFORM=Chrome

# Media handling: connector can emit metadata only by default.
# Set true only if Guard needs media bytes immediately.
DOWNLOAD_MEDIA=false
MAX_MEDIA_BYTES=10485760

# Event delivery
# db = write normalized events to whatsapp_connector.event_inbox (recommended with shared DB)
# http = POST normalized events to EVENT_WEBHOOK_URL
EVENT_SINK=db
EVENT_WEBHOOK_URL=
EVENT_WEBHOOK_TOKEN=
