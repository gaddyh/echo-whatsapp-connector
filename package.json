{
  "name": "echo-whatsapp-connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Baileys-based WhatsApp linked-device connector for Echo Guard",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/app.js",
    "test": "vitest run",
    "lint": "eslint .",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.3",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "qrcode": "^1.5.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "eslint": "^9.37.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
